NVCC ?= nvcc
A ?= sm_80

COMMON_FLAGS = -O3 -std=c++17 -lineinfo
FAST_FLAGS = $(COMMON_FLAGS) --use_fast_math

.RECIPEPREFIX := >

.PHONY: lib lib-int8 lib-int4 lib-int4-o2 lib-int4-o2-all lib-int4-o4-all lib-int4-o8-all lib-int4-kv-fp16 lib-int4-silu-fast lib-int4-fast lib-int4-attn-shm lib-int4-fused-attn lib-int4-fused-mlp lib-int4-ultra lib-int4-super lib-int4-t64 lib-int4-t256 lib-int4-prepack lib-int4-float clean-lib

lib:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int8:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT8_WEIGHTS=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-o2:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_LINEAR_I4_DP4A2=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-o2-all:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_LINEAR_I4_DP4A2=1 -DUSE_QKV_GATE_I4_DP4A2=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-o4-all:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_LINEAR_I4_DP4A4=1 -DUSE_QKV_GATE_I4_DP4A4=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-o8-all:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_LINEAR_I4_DP4A8=1 -DUSE_QKV_GATE_I4_DP4A8=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-kv-fp16:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FP16_KV_CACHE=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-silu-fast:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FAST_SILU=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-fast:
>mkdir -p build
>$(NVCC) $(FAST_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FAST_SILU=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-attn-shm:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_ATTENTION_SHM=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-fused-attn:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FUSED_ROPE_ATTENTION=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-fused-mlp:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FUSED_MLP_QUANT=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-ultra:
>mkdir -p build
>$(NVCC) $(FAST_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FUSED_MLP_QUANT=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-super:
>mkdir -p build
>$(NVCC) $(FAST_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_FUSED_ROPE_ATTENTION=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-t64:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DLINEAR_THREADS_CFG=64 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-t256:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DLINEAR_THREADS_CFG=256 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-prepack:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -DUSE_INT4_DP4A=1 -DUSE_INT4_DP4A_PREPACK=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

lib-int4-float:
>mkdir -p build
>$(NVCC) $(COMMON_FLAGS) -DUSE_INT4_WEIGHTS=1 -arch=$(A) -Xcompiler -fPIC -shared src/llm_cuda_lib.cu -o build/libllm_cuda.so

clean-lib:
>rm -rf build
